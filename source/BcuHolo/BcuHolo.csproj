<Project Sdk="Microsoft.NET.Sdk">
	<!-- Inherits net8 target, shared bin output and the requireAdministrator manifest from ..\Directory.Build.props.
	     Must build into the same bin folder as BCUninstaller: the engine finds its helper exes beside UninstallTools.dll. -->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<AssemblyName>reddholo</AssemblyName>
		<Product>reddholo</Product>
		<UseWPF>true</UseWPF>
		<Nullable>disable</Nullable>
		<ApplicationIcon>holo.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="holo.ico" />
		<!-- PawnIO installer, shipped unmodified (GPL-2.0); only run from the Sensors page button after a hash check. -->
		<None Include="ThirdParty\PawnIO\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
		<ProjectReference Include="..\UninstallTools\UninstallTools.csproj" />
		<ProjectReference Include="..\KlocTools\KlocTools.csproj" />
		<ProjectReference Include="..\BcuHolo.Plugins\BcuHolo.Plugins.csproj" />
		<ProjectReference Include="..\Reddholo\Core\Reddholo.Core.csproj" />
	</ItemGroup>
</Project>
