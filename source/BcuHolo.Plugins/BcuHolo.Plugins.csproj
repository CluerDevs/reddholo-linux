<Project Sdk="Microsoft.NET.Sdk">
	<!-- The only assembly a reddholo module or sensor plugin needs to reference. Keep it small and stable. -->
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>false</UseWindowsForms>
		<Nullable>disable</Nullable>
		<ApplicationManifest />
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Reddholo\Core\Reddholo.Core.csproj" />
	</ItemGroup>
</Project>
