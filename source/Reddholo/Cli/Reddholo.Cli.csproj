<Project Sdk="Microsoft.NET.Sdk">
	<!-- Headless reddholo: prints this machine's sensors. Seed of the fleet agent's local read-out. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>reddholo-cli</AssemblyName>
		<RootNamespace>Reddholo.Cli</RootNamespace>
		<!-- Runs on minimal servers without libicu; output is invariant-culture anyway. -->
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Core\Reddholo.Core.csproj" />
	</ItemGroup>
</Project>
