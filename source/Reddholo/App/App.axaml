<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Reddholo.App.App"
             RequestedThemeVariant="Dark">
    <!-- Colours and glass gradients come from Themes.cs (applied at startup). Use DynamicResource for them. -->
    <Application.Resources>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas, DejaVu Sans Mono, monospace</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Glass card. BoxShadow is drawn once per layout, unlike WPF's DropShadowEffect, so live numbers stay cheap. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource GlassFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="24,20" />
            <Setter Property="BoxShadow" Value="0 8 32 0 #73000000" />
        </Style>

        <!-- Dashboard tile: a bigger, rounder card. -->
        <Style Selector="Border.tile">
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="MinHeight" Value="230" />
        </Style>

        <Style Selector="TextBlock.caps">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>

        <!-- Flat ghost button and toggle chip, with hover and keyboard focus rings. -->
        <Style Selector="Button.ghost, ToggleButton.chip">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="{DynamicResource GlassFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GlassFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>
        <Style Selector="Button.ghost:focus-visible /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chip:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.66}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>

        <!-- Main action (solid) and tinted standalone action; both also carry the ghost class for shape. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Danger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
            <Setter Property="Foreground" Value="{DynamicResource OnDanger}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="22,0" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Danger.CC}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
            <Setter Property="Foreground" Value="{DynamicResource OnDanger}" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentGlassFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.99}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
        </Style>

        <!-- Window caption buttons -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Danger}" />
        </Style>

        <!-- Rail entries -->
        <Style Selector="ListBox.rail">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.rail ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.rail ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.rail ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <Style Selector="ListBox.rail ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.rail ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.rail ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RailSelected}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.59}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
    </Application.Styles>
</Application>
